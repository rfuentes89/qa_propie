{
  "name": "qa-propie-playwright",
  "version": "1.0.0",
  "description": "Framework de QA automation con Playwright + TypeScript y Page Object Model sobre propie-weld.vercel.app",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://propie-weld.vercel.app/"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "pom",
    "typescript"
  ],
  "author": "QA Automation",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.7.0"
  }
}
